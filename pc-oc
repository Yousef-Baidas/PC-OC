#!/usr/bin/bash
set -euo pipefail
# pc-oc apply|revert|probe <component>|all
# Runs <component>/<verb>.sh next to this file. Only names in the list below run,
# so an argument can never point sudo at a path outside the install.

# As root, the test seams must not redirect writes: real /sys and /var/lib/pc-oc only
uid="$(/usr/bin/id -u)"
if [[ "$uid" == 0 ]]; then
  unset SYSFS_ROOT PC_OC_STATE
fi

# sudo can pass the caller's PATH through; look commands up only in root-owned
# /usr/bin, so a user-writable dir on PATH cannot supply bash (docs/adr/0001)
export PATH=/usr/bin

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$here/lib/common.sh"
# apply order; revert all walks it backwards
components=(cpu ram gpu os toolchain)

usage() {
  echo "usage: pc-oc apply|revert|probe <component>|all (components: ${components[*]})" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage
verb="$1"
target="$2"
case "$verb" in
  apply | revert | probe) ;;
  *) usage ;;
esac

# the incident on run log #1: a non-root apply/revert reached the real systemctl; refuse before any component runs
if [[ "$verb" != probe && "$uid" != 0 ]]; then
  echo "pc-oc: $verb needs root: sudo pc-oc $verb $target" >&2
  exit 1
fi

if [[ "$target" == all && "$verb" == revert ]]; then
  # keep going: stopping at a failure would leave the later components tuned
  failed=()
  for ((i = ${#components[@]} - 1; i >= 0; i--)); do
    c="${components[i]}"
    if [[ -f "$here/$c/revert.sh" ]]; then
      bash "$here/$c/revert.sh" || failed+=("$c")
    fi
  done
  [[ ${#failed[@]} -eq 0 ]] || die all "revert.sh failed: ${failed[*]}"
  exit 0
fi

if [[ "$target" == all ]]; then
  for c in "${components[@]}"; do
    if [[ -f "$here/$c/$verb.sh" ]]; then
      bash "$here/$c/$verb.sh" || die "$c" "$verb.sh failed"
    fi
  done
  exit 0
fi

for c in "${components[@]}"; do
  if [[ "$c" == "$target" && -f "$here/$c/$verb.sh" ]]; then
    bash "$here/$c/$verb.sh" || die "$c" "$verb.sh failed"
    exit 0
  fi
done
usage
