#!/usr/bin/env bash
# pc-oc-test-mock
# Mock gpu_burn for tests/gpu/load.bats (contract #134); never touches a GPU. The tests
# copy it into the fake build directory, where load.sh runs it as ./gpu_burn.
# Env: MOCK_STATE (dir: gpu_burn.args argv one per line, gpu_burn.cwd, and start = the
# load's start time, which the nvidia-smi mock reads), MOCK_BURN_OUT (timed output to
# replay), MOCK_BURN_EXIT (exit code, default 0: the real main() returns 0 on every path
# that reaches the summary).
# Fixture lines are "<ms since start>|<printf %b text>". The time may be written "end-<ms>"
# or "end": counted from the run time the tool was given (its last argument, in seconds),
# so one fixture serves a 2 s and a 3 s run. The text "@hang" sleeps until killed (40 s,
# longer than any timeout the tests allow).
set -u
export LC_ALL=C
: "${MOCK_STATE:?}" "${MOCK_BURN_OUT:?}"
printf '%s\n' "$@" >"$MOCK_STATE/gpu_burn.args"
pwd -P >"$MOCK_STATE/gpu_burn.cwd"
printf '%s\n' "$EPOCHREALTIME" >"$MOCK_STATE/start"
start_us="${EPOCHREALTIME/./}"
end_ms=2000
[[ ! "${*: -1}" =~ ^[0-9]+$ ]] || end_ms=$((${*: -1} * 1000))
while IFS='|' read -r at text; do
  [[ "$at" != end ]] || at="$end_ms"
  [[ ! "$at" =~ ^end-([0-9]+)$ ]] || at=$((end_ms - BASH_REMATCH[1]))
  [[ "$at" =~ ^[0-9]+$ ]] || continue
  wait_ms=$((at - (${EPOCHREALTIME/./} - start_us) / 1000))
  ((wait_ms <= 0)) || sleep "$(printf '%d.%03d' $((wait_ms / 1000)) $((wait_ms % 1000)))"
  [[ "$text" != "@hang" ]] || exec sleep 40
  printf '%b' "$text"
done <"$MOCK_BURN_OUT"
exit "${MOCK_BURN_EXIT:-0}"
