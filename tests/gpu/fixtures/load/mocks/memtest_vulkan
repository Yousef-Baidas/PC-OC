#!/usr/bin/env bash
# pc-oc-test-mock
# Mock memtest_vulkan for tests/gpu/load.bats (contract #134); never opens a Vulkan device.
# Env: MOCK_STATE (dir: memtest_vulkan.args argv one per line, memtest_vulkan.env the
# VK_DRIVER_FILES it saw, memtest_vulkan.signal the signal that ended it, and start = the
# load's start time, which the nvidia-smi mock reads), MOCK_MEMTEST_OUT (timed output to
# replay), MOCK_MEMTEST_EXIT (status byte, default 65 = 0x40 signature | 0x01 inited).
# Like v0.5.0 started with a device number (src/close.rs, setup_handler(false)) it runs
# until it is signalled: SIGINT exits at once with the status byte, SIGTERM with the byte
# | 0x10 (QUIT_JOB_REQUESTED). Fixture lines are "<ms since start>|<printf %b text>"; the
# text "@exit <n>" makes it exit on its own with <n>. Unsignalled for 20 s after the last
# line it exits 99.
if [[ -z "${MOCK_MEMTEST_INNER:-}" ]]; then
  # The real tool installs its handlers with sigaction whatever it inherited. bash cannot
  # trap a signal that was ignored at entry (a shell's background job ignores SIGINT), so
  # put the dispositions back to default first.
  MOCK_MEMTEST_INNER=1 exec env --default-signal=INT,TERM bash "$0" "$@"
fi
set -u
export LC_ALL=C
: "${MOCK_STATE:?}" "${MOCK_MEMTEST_OUT:?}"
printf '%s\n' "$@" >"$MOCK_STATE/memtest_vulkan.args"
printf 'VK_DRIVER_FILES=%s\n' "${VK_DRIVER_FILES-<unset>}" >"$MOCK_STATE/memtest_vulkan.env"
printf '%s\n' "$EPOCHREALTIME" >"$MOCK_STATE/start"
code="${MOCK_MEMTEST_EXIT:-65}"
nap=""
# shellcheck disable=SC2329 # called from the traps below
on_signal() {
  printf '%s\n' "$1" >"$MOCK_STATE/memtest_vulkan.signal"
  [[ -z "$nap" ]] || kill "$nap" 2>/dev/null
  exit "$2"
}
trap 'on_signal INT "$code"' INT
trap 'on_signal TERM "$((code | 16))"' TERM
# pause <ms>: sleep in the background and wait, so a trap runs at once
pause() {
  sleep "$(printf '%d.%03d' $(($1 / 1000)) $(($1 % 1000)))" &
  nap=$!
  wait "$nap"
  nap=""
}
start_us="${EPOCHREALTIME/./}"
while IFS='|' read -r at text; do
  [[ "$at" =~ ^[0-9]+$ ]] || continue
  wait_ms=$((at - (${EPOCHREALTIME/./} - start_us) / 1000))
  ((wait_ms <= 0)) || pause "$wait_ms"
  [[ "$text" != "@exit "* ]] || exit "${text#@exit }"
  printf '%b' "$text"
done <"$MOCK_MEMTEST_OUT"
for _ in {1..100}; do pause 200; done
exit 99
