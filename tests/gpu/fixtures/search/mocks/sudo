#!/usr/bin/bash
# pc-oc-test-mock
# Mock sudo for tests/gpu/search.bats (contract #135); guard.sh binds it over
# /usr/bin/sudo: the search runs as root already; the real one is never reached.
# A call is recorded and returns 0 at once.
# State directory: /var/lib/pc-oc-test-mock
#   events  "sudo <arguments>" per call
#   sudo.env  the environment of every call
set -u
s=/var/lib/pc-oc-test-mock
[[ -e "$s/scratch" ]] || {
  echo "mock sudo: $s is not the test scratch" >&2
  exit 96
}
{
  echo "-- sudo $*"
  /usr/bin/env
} >>"$s/sudo.env"
printf 'sudo %s\n' "$*" >>"$s/events"
exit 0
