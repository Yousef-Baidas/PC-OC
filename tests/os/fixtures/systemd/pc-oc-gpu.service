# src: sd-service, sd-exec
[Unit]
Description=pc-oc: GPU power limit and clock offsets at boot
ConditionPathExists=/usr/local/lib/pc-oc/pc-oc
StartLimitIntervalSec=infinity
StartLimitBurst=6

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pc-oc/pc-oc apply gpu
TimeoutStartSec=60
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
